%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: aoi_advice_op1
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFQu\xE9 debo hacer ahora?"
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Forja el M\xF3dulo de espada en el campamento de Kaede: 10 Almas antiguas y 5 Circuitos antiguos."
    condition:
      requires: 
      forbids: sword_upgraded
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Los golems de la llanura guardan ambos. No temas: yo correr\xE9 contigo."
    condition:
      requires: 
      forbids: sword_upgraded
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "La espada ya despert\xF3. Ve al Bosque Quebrado, al este, y rompe el sello carmes\xED."
    condition:
      requires: sword_upgraded
      forbids: seal_opened
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "El guardi\xE1n duerme m\xE1s all\xE1 del sello. Para despertarlo necesitas una Gota de Amrita."
    condition:
      requires: seal_opened
      forbids: guardian_awakened,permit_obtained
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: 'Kaede puede forjarla: 5 Flores destello y 3 Almas antiguas.'
    condition:
      requires: seal_opened
      forbids: guardian_awakened,permit_obtained
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: Varn te espera. Su permiso es el primer paso hacia el Gran Juzgado... y hacia Hikari.
    condition:
      requires: guardian_awakened
      forbids: permit_obtained
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Tienes el primer permiso. Vuelve con Kaede: ella sabr\xE1 hacia d\xF3nde seguir."
    condition:
      requires: permit_obtained
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: Estoy orgullosa de ti, portador.
    condition:
      requires: permit_obtained
      forbids: 
  choices: []
  choiceSpeaker: 
  continueWith: {fileID: 0}
