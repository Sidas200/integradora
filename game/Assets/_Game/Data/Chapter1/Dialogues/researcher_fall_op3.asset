  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "No conf\xEDo en ti."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xA1Perfecto! La desconfianza tambi\xE9n es un dato. Lo anoto."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Pero sin mi forja no le har\xE1s ni un rasgu\xF1o a un guardi\xE1n. Pi\xE9nsalo."
    condition:
      requires: 
      forbids: 
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "...Busco a una chica que se llev\xF3 un rayo de luz. Ay\xFAdame a encontrarla y hay trato."
    condition:
      requires: 
      forbids: 
  choices: []
  choiceSpeaker: 
