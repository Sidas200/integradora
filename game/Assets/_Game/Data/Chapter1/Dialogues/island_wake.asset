  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: island_wake
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "...\xBFD\xF3nde estoy? Hay flores por todas partes."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "Hikari... la luz se la llev\xF3 hacia arriba. Tengo que encontrarla."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "Mi mano. Esta marca... es la misma que ten\xEDa ella."
  - speaker: 
    portrait: {fileID: 0}
    text: "Mu\xE9vete con {move}. Pulsa {interact} cerca de algo para interactuar."
