  lockedByDesigner: 0
  lines:
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Mi lugar est\xE1 en tu espada. Perm\xEDteme volver a ella... y prestarte mi rayo."
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Las dem\xE1s doncellas a\xFAn duermen. F\xF3rjale un M\xF3dulo con las almas de los golems: as\xED romper\xE1s el sello del guardi\xE1n."
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: Ve, portador. Desde ahora, viajo contigo.
    condition:
      requires: 
      forbids: 
