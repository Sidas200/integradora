  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: camp_materials
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xA1Volviste! \xBFEncontraste algo raro? Lo que sea. Me sirve todo."
    condition:
      requires: 
      forbids: kaede_meet_distrust
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xBFOtra vez por aqu\xED? Empiezo a pensar que s\xED conf\xEDas en m\xED."
    condition:
      requires: kaede_meet_distrust
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "El santuario est\xE1 al norte de la llanura. Su puerta pide un Alma peque\xF1a."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: Los Custodios de ruinas la guardan. Los slimes sueltan flores y restos para pociones y armadura.
    condition:
      requires: 
      forbids: 
