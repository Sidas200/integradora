  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFQu\xE9 le pas\xF3 al rey de la leyenda?"
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Rompi\xF3 las reglas del cielo para salvarnos a todos... y el cielo nunca lo perdon\xF3."
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "T\xFA me recuerdas a \xE9l. Por eso, con todo respeto, te pido algo: no repitas su final."
    condition:
      requires: 
      forbids: 
