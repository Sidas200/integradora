  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: camp_upgraded
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Esa espada ya puede herir a un guardi\xE1n. \xA1Mira c\xF3mo vibra! ...Perd\xF3n. Sigo."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Ve al Bosque Quebrado, al este. No olvides la Gota de Amrita: 5 Flores destello y 3 Almas antiguas. Sin ella, Varn no despertar\xE1."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Y no te mueras. Todav\xEDa no termino de estudiarte."
    condition:
      requires: 
      forbids: kaede_meet_question
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Y no te mueras. Me debes una medici\xF3n, \xBFrecuerdas?"
    condition:
      requires: kaede_meet_question
      forbids: 
