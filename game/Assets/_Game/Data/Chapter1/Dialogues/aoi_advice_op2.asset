MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: aoi_advice_op2
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: Dame un consejo de combate.
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Cuando un enemigo ataque, cruza a trav\xE9s de \xE9l con mi rayo: lo da\xF1ar\xE1s sin recibir el golpe."
    condition:
      requires: 
      forbids: guardian_awakened
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Y si esquivas justo a tiempo, el mundo se volver\xE1 lento para ti."
    condition:
      requires: 
      forbids: guardian_awakened
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: Contra Varn, sal de las zonas rojas antes del golpe y ataca cuando quede vulnerable.
    condition:
      requires: guardian_awakened
      forbids: permit_obtained
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Cuando desenvaine, su golpe al suelo lanza una onda. Al\xE9jate del c\xEDrculo grande... o cr\xFAzalo como rayo."
    condition:
      requires: guardian_awakened
      forbids: permit_obtained
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Cada guardi\xE1n ser\xE1 m\xE1s fuerte que el anterior. Pero t\xFA tambi\xE9n lo ser\xE1s, portador."
    condition:
      requires: permit_obtained
      forbids: 
  choices: []
  choiceSpeaker: 
  continueWith: {fileID: 0}
