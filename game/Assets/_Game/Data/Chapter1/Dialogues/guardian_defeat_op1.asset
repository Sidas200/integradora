  lockedByDesigner: 0
  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "Una chica con mi misma marca. Se la llev\xF3 un rayo de luz. \xBFAd\xF3nde?"
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "Al Gran Juzgado. Todos los marcados terminan ah\xED."
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "Si alguien puede llegar antes del juicio, eres t\xFA."
    condition:
      requires: varn_respect
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: Si quieres llegar antes del juicio, no te detengas.
    condition:
      requires: 
      forbids: varn_respect
