  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFPor qu\xE9 sirves a un dios que encierra a los humanos?"
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "Sirvo a la ley. Sin ella, este mundo ya habr\xEDa ca\xEDdo."
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "...O eso me repito desde hace mil a\xF1os."
