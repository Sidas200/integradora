%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: camp_briefing
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xA1Llegaste! Bienvenido a mi escondite. Aqu\xED no llegan los ojos del cielo."
    condition:
      requires: 
      forbids: kaede_meet_question,kaede_meet_distrust
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xA1Llegaste! Tranquilo, hoy solo vamos a hablar. Las mediciones, despu\xE9s. ...Bueno, quiz\xE1s una."
    condition:
      requires: kaede_meet_question
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Viniste, aunque no conf\xEDas en m\xED. \xBFVes? Sigo sin delatarte. Punto para m\xED."
    condition:
      requires: kaede_meet_distrust
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Escucha bien. Esta isla tiene cuatro zonas. En el centro est\xE1 el Gran Juzgado: el dios de la justicia."
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Si se llevaron a tu amiga, seguro est\xE1 ah\xED. Pero para entrar necesitas los permisos de los cuatro guardianes."
    condition:
      requires: 
      forbids: 
  choices:
  - text: "Entonces ir\xE9 por los cuatro."
    next: {fileID: 11400000, guid: 8a05f301f056e466bb0c97fb018739f8, type: 2}
    setFlag: kaede_briefing_resolve
  - text: "\xBFPor qu\xE9 me ayudas de verdad?"
    next: {fileID: 11400000, guid: 75b9106b2bc50430da9863e784b86f54, type: 2}
    setFlag: kaede_briefing_why
  - text: "\xBFY si mejor fuerzo la entrada?"
    next: {fileID: 11400000, guid: d2ab8e5502e6d41e7b5f3cf266016041, type: 2}
    setFlag: kaede_briefing_force
  choiceSpeaker: 
  continueWith: {fileID: 0}
