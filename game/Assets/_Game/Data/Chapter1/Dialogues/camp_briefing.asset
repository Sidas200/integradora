%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: camp_briefing
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Bienvenido a mi escondite. Aqu\xED no llegan los ojos del cielo."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Escucha bien. Esta isla tiene cuatro zonas. En el centro est\xE1 el Gran Juzgado: el dios de la justicia."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Si se llevaron a tu amiga, seguro est\xE1 ah\xED. Pero para entrar necesitas los permisos de los cuatro guardianes."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: En cada zona hay un santuario. En cada uno duerme una de las cuatro doncellas de la leyenda.
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFLas doncellas de la espada del rey?"
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Las mismas. Y creo que tu espada carmes\xED puede despertarlas."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: 'Otra cosa: las armas normales no hieren a un dios. Ni a sus guardianes.'
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "El guardi\xE1n de esta zona espera al este, en el Bosque Quebrado, detr\xE1s de un sello."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Primero, el santuario del norte. Su puerta solo se abre con un Alma peque\xF1a."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Los Custodios de ruinas guardan almas dentro. Vence a uno y la tendr\xE1s."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Con las Almas antiguas y los Circuitos que sueltan los golems forjamos un M\xF3dulo de espada."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Y el guardi\xE1n duerme. Para despertarlo necesitar\xE1s una Gota de Amrita: tambi\xE9n sale de la forja."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Si te sobra cuero y restos de slime, f\xF3rjate una armadura. La vas a necesitar."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: 'Antes de salir, toca el cristal: guarda tu avance.'
