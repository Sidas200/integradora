  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFPor qu\xE9 esta espada me eligi\xF3 a m\xED?"
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "No te eligi\xF3, portador. Te reconoci\xF3."
    condition:
      requires: 
      forbids: 
  - speaker: Aoi
    portrait: {fileID: 21300000, guid: 75b1f1f88f6ed40b993dc3c8db33a6af, type: 3}
    text: "Tienes la misma terquedad que \xE9l... y un coraz\xF3n m\xE1s noble. Me inclino ante ti."
    condition:
      requires: 
      forbids: 
