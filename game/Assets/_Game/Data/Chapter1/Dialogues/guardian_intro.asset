  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: guardian_intro
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: "La Amrita cae sobre la piedra. Los ojos del guardi\xE1n se encienden."
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "...\xBFQui\xE9n me despierta? Un humano... con la marca de Rulebreaker."
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "Soy Varn, guardi\xE1n del umbral. Ning\xFAn condenado pasa m\xE1s all\xE1 de este punto."
    condition:
      requires: 
      forbids: 
  choices:
  - text: Entonces pelea conmigo, Varn.
    next: {fileID: 11400000, guid: 2c19470b1b48d4cd291fba1925f1de7c, type: 2}
    setFlag: varn_respect
  - text: No soy un condenado.
    next: {fileID: 11400000, guid: 2857edb43171f4fd2aae802f25f6d109, type: 2}
    setFlag: varn_intro_innocent
  - text: "D\xE9jame pasar y nadie sale herido."
    next: {fileID: 11400000, guid: c1f46a9334a1b4d3a874c9483f2e5194, type: 2}
    setFlag: varn_intro_threat
