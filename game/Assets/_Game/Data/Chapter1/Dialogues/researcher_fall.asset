MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: researcher_fall
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "\xA1Aaah! ...Auch. Esa rama no era tan firme como pensaba."
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "T\xFA... no tienes alas de luz ni ojos de piedra. Eres humano. Un humano de verdad."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFTan raro es?"
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Aqu\xED, s\xED. Y esa marca en tu mano es la de Rulebreaker. Si alguien m\xE1s la ve, te ejecutan."
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: Tranquilo, no voy a delatarte. Me da demasiada curiosidad.
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Soy Kaede. Investigo cosas que no deber\xEDa. Tengo una base escondida entre los \xE1rboles, al oeste."
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Hay una forja. Te dejo usarla si me dejas estudiarte. \xBFTrato?"
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: Busco a una chica que se llevaron con un rayo de luz. Si me ayudas, acepto.
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: 'Trato hecho. Te veo en el campamento: sigue el camino hacia el oeste.'
