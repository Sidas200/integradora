  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xBFEstudiarme? \xBFQu\xE9 me vas a hacer exactamente?"
    condition:
      requires: 
      forbids: 
  - speaker: Kaede
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: "Nada que duela. ...Casi nada. Preguntas, mediciones, tal vez una muestra de esa marca. Peque\xF1a. Diminuta."
    condition:
      requires: 
      forbids: 
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "...Est\xE1 bien. Pero a cambio me ayudas a encontrar a una chica que se llev\xF3 el cielo."
    condition:
      requires: 
      forbids: 
