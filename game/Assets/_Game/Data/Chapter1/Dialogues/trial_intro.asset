  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: trial_intro
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: "La espada carmes\xED brilla al acercarse a la estatua. Una voz resuena en la sala."
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: Portador... muchos trajeron espadas. Ninguna era digna.
  - speaker: ???
    portrait: {fileID: 21300000, guid: 90c97c6082e584db3be51f2edeb1da7e, type: 3}
    text: Demuestra que la tuya lo es. Sobrevive a la prueba.
  - speaker: 
    portrait: {fileID: 0}
    text: "La entrada se sella. Algo despierta en los c\xEDrculos del suelo."
