%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: intro
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: "Hace mil a\xF1os, un rey desafi\xF3 a los dioses para salvar a la humanidad."
  - speaker: 
    portrait: {fileID: 0}
    text: "Lo acompa\xF1aron un pecador, una bestia y cuatro doncellas que daban poder a su espada."
  - speaker: 
    portrait: {fileID: 0}
    text: Al final, las doncellas quedaron selladas en la espada. Al rey lo llamaron Rulebreaker.
  - speaker: 
    portrait: {fileID: 0}
    text: "Los humanos bendecidos fueron aislados en islas del cielo. Y el mundo sigui\xF3 adelante."
  - speaker: 
    portrait: {fileID: 0}
    text: "Mil a\xF1os despu\xE9s..."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xA1Te tengo! ...\xBFEst\xE1s bien? Ca\xEDste del cielo."
  - speaker: Hikari
    portrait: {fileID: 21300000, guid: 5347737efc7034f7d81a6eb704bff50c, type: 3}
    text: Gracias por atraparme. Me llamo Hikari.
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "Esa marca en tu mano... \xBFte duele?"
  - speaker: Hikari
    portrait: {fileID: 21300000, guid: 5347737efc7034f7d81a6eb704bff50c, type: 3}
    text: Dicen que es una sentencia. Pero contigo cerca no tengo miedo.
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: 'Entonces no me voy a ir. Te lo prometo: vamos a estar juntos.'
  - speaker: 
    portrait: {fileID: 0}
    text: "Un rayo de luz cay\xF3 del cielo. Una figura sin rostro tom\xF3 a Hikari y subi\xF3 con ella."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: "\xA1Hikari! ...No voy a romper mi promesa."
  - speaker: 
    portrait: {fileID: 0}
    text: "Tsuki salt\xF3 hacia la luz."
