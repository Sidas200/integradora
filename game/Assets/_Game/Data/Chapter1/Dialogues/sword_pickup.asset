  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: "Una espada carmes\xED, sin filo. Pesa menos de lo que parece."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: Es como si me estuviera esperando... Me la llevo.
  - speaker: 
    portrait: {fileID: 0}
    text: "Obtuviste la Espada carmes\xED. Clic izquierdo o J: atacar. Espacio: esquivar."
