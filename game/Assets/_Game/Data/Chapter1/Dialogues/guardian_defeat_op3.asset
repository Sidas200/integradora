  lines:
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: Peleaste bien, Varn.
    condition:
      requires: 
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: Viniendo de ti, lo acepto con orgullo.
    condition:
      requires: varn_respect
      forbids: 
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "No necesito la l\xE1stima de un humano."
    condition:
      requires: 
      forbids: varn_respect
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: ...Pero acepto el respeto.
    condition:
      requires: 
      forbids: varn_respect
