  m_Script: {fileID: 11500000, guid: 3e4285355d7234af4a5c7418047c645c, type: 3}
  m_Name: guardian_sword
  m_EditorClassIdentifier: Game.Gameplay::DialogueData
  lockedByDesigner: 0
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: Varn hunde la mano en su pecho y arranca una espada de luz roja. El cielo se cierra sobre el umbral.
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: Hace siglos que nadie me obligaba a desenvainar.
  - speaker: Varn
    portrait: {fileID: 21300000, guid: e84f912d4eed34337868ea71e8b7ce68, type: 3}
    text: "Se acab\xF3 el juego, humano. Ahora s\xED voy a tomarte en serio."
  - speaker: Tsuki
    portrait: {fileID: 21300000, guid: 3efdcac1e115744e8b625ebc29df26fe, type: 3}
    text: ...Bien. Yo tampoco pienso contenerme.
  - speaker: 
    portrait: {fileID: 0}
    text: "Varn encadena sus ataques y su golpe al suelo lanza una onda. Sal tambi\xE9n del c\xEDrculo grande."
